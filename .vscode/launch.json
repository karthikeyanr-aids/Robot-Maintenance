{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Backend Server",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/server.js",
      "restart": true,
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Frontend in Chrome",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/client"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Train ML Model",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/ml/trainModel.js",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Seed Database",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/seed/seedData.js",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Chrome)",
      "configurations": ["Backend Server", "Frontend in Chrome"]
    }
  ]
}